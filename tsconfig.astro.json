{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": "."
  },
  "include": [
    ".astro/types.d.ts",
    "env.d.ts",
    "src/content.config.ts",
    "src/content/**/*",
    "src/**/*.astro",
    "src/components/**/*.astro",
    "src/components/**/*.ts",
    "src/overrides/**/*.astro",
    "src/splashHeroTypes.ts"
  ],
  "exclude": ["dist", "node_modules", "docs-site", "src/callspec-ui/ui/**", "src/cs-pagefind/**"]
}
