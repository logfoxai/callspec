---
import {Icon, LinkButton} from '@astrojs/starlight/components';
import type {SplashHeroAction, SplashHeroActionList} from '../splashHeroTypes';
import {splashHeroIconName} from '../splashHeroTypes';
import {withDemoLinkOpenAttrs} from './splashCtaIcons';

interface Props {
	actions: SplashHeroActionList;
}

const {actions = []} = Astro.props;

function actionIconName(action: SplashHeroAction): ReturnType<typeof splashHeroIconName> {
	const raw = action.icon;
	if (!raw) return undefined;
	// Starlight hero schema: { type: 'icon', name } | { type: 'raw', html }
	if (typeof raw === 'object' && 'name' in raw && typeof raw.name === 'string') {
		return splashHeroIconName(raw.name);
	}
	return undefined;
}

function actionIconHtml(action: SplashHeroAction): string | undefined {
	const raw = action.icon;
	if (raw && typeof raw === 'object' && 'html' in raw && typeof raw.html === 'string') {
		return raw.html;
	}
	return undefined;
}
---

{
	actions.length > 0 && (
		<div class="splash-hero__actions">
			{actions.map((action: SplashHeroAction) => {
				const {text, link: href, variant} = action;
				const className = action.attrs?.class;
				const attrs = withDemoLinkOpenAttrs(href, {...(action.attrs ?? {})});
				delete attrs.class;

				const htmlIcon = actionIconHtml(action);
				const namedIcon = htmlIcon ? undefined : actionIconName(action);
				const iconPlacement =
					htmlIcon ||
					namedIcon === 'github' ||
					namedIcon === 'laptop' ||
					namedIcon === 'open-book'
						? 'start'
						: 'end';

				return (
					<LinkButton
						{href}
						{variant}
						iconPlacement={iconPlacement}
						class:list={[
							className,
							namedIcon === 'right-arrow' && 'sl-link-button--forward',
							namedIcon === 'left-arrow' && 'sl-link-button--back',
						]}
						{...attrs}
					>
						{htmlIcon && iconPlacement === 'start' && <Fragment set:html={htmlIcon} />}
						{namedIcon && iconPlacement === 'start' && (
							<Icon name={namedIcon} size="1.55rem" class="splash-hero__cta-icon" />
						)}
						{text}
						{htmlIcon && iconPlacement === 'end' && <Fragment set:html={htmlIcon} />}
						{namedIcon && iconPlacement === 'end' && (
							<Icon name={namedIcon} size="1.55rem" class="splash-hero__cta-icon" />
						)}
					</LinkButton>
				);
			})}
		</div>
	)
}
