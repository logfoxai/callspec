---
/**
 * Social proof strip — stars, license, agents, TypeScript.
 */
---

<section class="splash-proof" aria-label="Social proof">
	<ul class="splash-proof__list">
		<li>
			<a
				class="splash-proof__link"
				href="https://github.com/logfoxai/callspec"
				target="_blank"
				rel="noopener noreferrer"
			>
				<span class="splash-proof__value" data-github-stars>GitHub</span>
				<span class="splash-proof__label">open source</span>
			</a>
		</li>
		<li>
			<span class="splash-proof__value">MIT</span>
			<span class="splash-proof__label">licensed</span>
		</li>
		<li>
			<a class="splash-proof__link" href="/coding-agents/">
				<span class="splash-proof__value">Agents</span>
				<span class="splash-proof__label">skill + prompts</span>
			</a>
		</li>
		<li>
			<span class="splash-proof__value">TypeScript</span>
			<span class="splash-proof__label">end to end</span>
		</li>
	</ul>
</section>

<script>
	async function loadStars() {
		const el = document.querySelector('[data-github-stars]');
		if (!(el instanceof HTMLElement)) return;
		try {
			const res = await fetch('https://api.github.com/repos/logfoxai/callspec');
			if (!res.ok) return;
			const data = await res.json();
			const stars = data.stargazers_count;
			if (typeof stars !== 'number') return;
			el.textContent = stars >= 1000 ? `${(stars / 1000).toFixed(1)}k★` : `${stars}★`;
		} catch {
			/* keep GitHub label */
		}
	}
	loadStars();
	document.addEventListener('astro:page-load', loadStars);
</script>
