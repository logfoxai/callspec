---
/**
 * Idle / empty / in-flight polish for Starlight’s Pagefind search dialog.
 * Injects suggestion chips when idle, Discord help on zero results, a
 * shimmer skeleton while a query is running, and arrow/Enter keyboard nav.
 */
const discordInvite = 'https://discord.gg/2wyYnBDhWQ';
---

<template id="cs-search-idle-template">
	<div class="cs-search-idle" data-cs-search-idle hidden>
		<p class="cs-search-idle__eyebrow">Search the docs</p>
		<p class="cs-search-idle__lead">Guides, API reference, MCP, SDK generation, and more.</p>
		<ul class="cs-search-idle__chips" role="list">
			<li><button type="button" data-cs-search-suggestion="route">route</button></li>
			<li><button type="button" data-cs-search-suggestion="MCP">MCP</button></li>
			<li><button type="button" data-cs-search-suggestion="errors">errors</button></li>
			<li><button type="button" data-cs-search-suggestion="OpenAPI">OpenAPI</button></li>
			<li><button type="button" data-cs-search-suggestion="SDK">SDK</button></li>
		</ul>
	</div>
</template>

<template id="cs-search-empty-help-template">
	<p class="cs-search-empty-help" data-cs-search-empty-help hidden>
		Stuck? Ask in <a href={discordInvite} target="_blank" rel="noopener noreferrer">Discord</a>.
	</p>
</template>

<template id="cs-search-pending-template">
	<div class="cs-search-pending" data-cs-search-pending hidden aria-hidden="true">
		<div class="cs-search-pending__row"></div>
		<div class="cs-search-pending__row"></div>
		<div class="cs-search-pending__row cs-search-pending__row--short"></div>
	</div>
</template>

<script>
	import {isSearchIdle} from './searchIdleState';
	import {
		applySelection,
		collectResultRows,
		collectSuggestionChips,
		handleSearchKey,
		markAwaitingFreshResults,
		resolveKeyboardSelection,
		resultLinkForRow,
		settleAwaitingResults,
		type KeyboardNavMode,
		type KeyboardNavState,
	} from './searchKeyboardNav';

	/** Slightly above PagefindUI debounceTimeoutMs (150) so settled rows are accepted. */
	const SEARCH_NAV_SETTLE_MS = 200;

	function ensureIdlePanel(frame: Element): HTMLElement | null {
		const existing = frame.querySelector<HTMLElement>('[data-cs-search-idle]');
		if (existing) return existing;

		const template = document.querySelector<HTMLTemplateElement>('#cs-search-idle-template');
		const idle = template?.content.firstElementChild?.cloneNode(true);
		if (!(idle instanceof HTMLElement)) return null;

		const host =
			frame.querySelector('.search-container') ??
			frame.querySelector('#starlight__search')?.parentElement ??
			frame;
		host.appendChild(idle);
		return idle;
	}

	function ensureEmptyHelp(root: Element): HTMLElement | null {
		const existing = root.querySelector<HTMLElement>('[data-cs-search-empty-help]');
		if (existing) return existing;

		const area = root.querySelector('.pagefind-ui__results-area');
		if (!area) return null;

		const template = document.querySelector<HTMLTemplateElement>('#cs-search-empty-help-template');
		const help = template?.content.firstElementChild?.cloneNode(true);
		if (!(help instanceof HTMLElement)) return null;

		area.appendChild(help);
		return help;
	}

	function ensurePending(root: Element): HTMLElement | null {
		const existing = root.querySelector<HTMLElement>('[data-cs-search-pending]');
		if (existing) return existing;

		const area = root.querySelector('.pagefind-ui__results-area');
		if (!area) return null;

		const template = document.querySelector<HTMLTemplateElement>('#cs-search-pending-template');
		const pending = template?.content.firstElementChild?.cloneNode(true);
		if (!(pending instanceof HTMLElement)) return null;

		area.appendChild(pending);
		return pending;
	}

	function setQuery(root: Element, query: string) {
		const input = root.querySelector<HTMLInputElement>('.pagefind-ui__search-input');
		if (!input) return;
		const setter = Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, 'value')?.set;
		setter?.call(input, query);
		input.dispatchEvent(new Event('input', {bubbles: true}));
		input.focus();
	}

	function isZeroResults(root: Element): boolean {
		if (root.querySelector('.pagefind-ui__result')) return false;
		const message = root.querySelector('.pagefind-ui__message')?.textContent ?? '';
		if (!message.trim()) return false;
		return !/searching/i.test(message);
	}

	function syncPanels(root: Element, idle: HTMLElement) {
		const siteSearch = root.closest('site-search');
		const searchReady =
			Boolean(siteSearch?.hasAttribute('data-cs-search-ready')) ||
			Boolean(root.querySelector('.pagefind-ui__search-input'));
		const drawer = root.querySelector('.pagefind-ui__drawer');
		const input = root.querySelector<HTMLInputElement>('.pagefind-ui__search-input');
		const drawerHidden = !drawer || drawer.classList.contains('pagefind-ui__hidden');
		const query = input?.value ?? '';
		const idleNow = isSearchIdle(searchReady, drawerHidden, query);
		const zeroNow = searchReady && !idleNow && isZeroResults(root);
		const message = root.querySelector('.pagefind-ui__message')?.textContent ?? '';
		const searchingMessage = /searching/i.test(message);
		// Only treat as searching once Pagefind opens the drawer / shows its
		// searching copy — not during the debounce window when the drawer is still hidden
		// (that would reserve min-height with no visible skeleton).
		const searchingNow =
			searchReady &&
			!idleNow &&
			!root.querySelector('.pagefind-ui__result') &&
			!zeroNow &&
			(!drawerHidden || searchingMessage);
		idle.hidden = !idleNow;

		const help = ensureEmptyHelp(root);
		if (help) help.hidden = !zeroNow;

		const dialog = root.closest('dialog');
		if (!dialog) return;
		if (!searchReady) {
			dialog.dataset.csSearch = 'loading';
		} else if (idleNow) {
			dialog.dataset.csSearch = 'idle';
		} else if (root.querySelector('.pagefind-ui__result')) {
			dialog.dataset.csSearch = 'results';
		} else if (zeroNow) {
			dialog.dataset.csSearch = 'empty';
		} else if (searchingNow) {
			dialog.dataset.csSearch = 'searching';
		} else {
			dialog.dataset.csSearch = 'querying';
		}

		const pending = ensurePending(root);
		if (pending) pending.hidden = dialog.dataset.csSearch !== 'searching';
	}

	function bindSiteSearch(siteSearch: HTMLElement) {
		if (siteSearch.dataset.csSearchPolishBound === '1') return;
		siteSearch.dataset.csSearchPolishBound = '1';

		const frame = siteSearch.querySelector('.dialog-frame');
		const root = siteSearch.querySelector('#starlight__search');
		if (!frame || !root) return;

		const idle = ensureIdlePanel(frame);
		if (!idle) return;

		const dialog = siteSearch.querySelector('dialog');
		let navState: KeyboardNavState = {
			selectedIndex: -1,
			lastFingerprint: '',
			awaitingFreshResults: false,
		};
		let settleTimer: ReturnType<typeof setTimeout> | undefined;

		const navMode = (): KeyboardNavMode => {
			const mode = dialog?.dataset.csSearch;
			if (mode === 'idle') return 'idle';
			if (mode === 'results') return 'results';
			return 'other';
		};

		const fingerprintFor = (mode: KeyboardNavMode, rows: HTMLElement[], chips: HTMLElement[]): string => {
			if (mode === 'results') {
				return `results:${rows.map((row) => resultLinkForRow(row)?.href ?? '').join('\0')}`;
			}
			if (mode === 'idle') return `idle:${chips.length}`;
			return mode;
		};

		const selectableItems = (mode: KeyboardNavMode, rows: HTMLElement[], chips: HTMLElement[]): HTMLElement[] => {
			if (mode === 'idle') return chips;
			if (mode === 'results' && !navState.awaitingFreshResults) return rows;
			return [];
		};

		const paintSelection = (mode: KeyboardNavMode, rows: HTMLElement[], chips: HTMLElement[]) => {
			const items = selectableItems(mode, rows, chips);
			applySelection(rows, -1);
			applySelection(chips, -1);
			applySelection(items, navState.selectedIndex);
		};

		const syncSelection = () => {
			syncPanels(root, idle);
			const mode = navMode();
			const rows = collectResultRows(root);
			const chips = collectSuggestionChips(idle);
			const fp = fingerprintFor(mode, rows, chips);
			navState = resolveKeyboardSelection(navState, mode, fp, mode === 'idle' ? chips.length : rows.length);
			paintSelection(mode, rows, chips);
		};

		const scheduleAwaitingSettle = () => {
			clearTimeout(settleTimer);
			settleTimer = setTimeout(() => {
				if (!navState.awaitingFreshResults) return;
				const mode = navMode();
				const rows = collectResultRows(root);
				const chips = collectSuggestionChips(idle);
				const fp = fingerprintFor(mode, rows, chips);
				navState = settleAwaitingResults(navState, fp, rows.length);
				paintSelection(mode, rows, chips);
			}, SEARCH_NAV_SETTLE_MS);
		};

		idle.addEventListener('click', (event) => {
			const target = event.target;
			if (!(target instanceof HTMLElement)) return;
			const suggestion = target.closest<HTMLElement>('[data-cs-search-suggestion]');
			const query = suggestion?.dataset.csSearchSuggestion;
			if (!query) return;
			setQuery(root, query);
			syncSelection();
		});

		const sync = () => syncSelection();
		const observer = new MutationObserver(sync);
		observer.observe(root, {
			subtree: true,
			childList: true,
			attributes: true,
			attributeFilter: ['class'],
		});
		observer.observe(siteSearch, {
			attributes: true,
			attributeFilter: ['data-cs-search-ready'],
		});

		root.addEventListener('input', () => {
			navState = markAwaitingFreshResults(navState);
			syncSelection();
			scheduleAwaitingSettle();
		});
		root.addEventListener('keyup', sync);

		if (dialog) {
			observer.observe(dialog, {attributes: true, attributeFilter: ['open']});
			dialog.addEventListener('close', () => {
				clearTimeout(settleTimer);
				navState = {
					selectedIndex: -1,
					lastFingerprint: '',
					awaitingFreshResults: false,
				};
				syncSelection();
			});
			dialog.addEventListener(
				'keydown',
				(event) => {
					if (!dialog.open) return;
					const mode = navMode();
					const rows = collectResultRows(root);
					const chips = collectSuggestionChips(idle);
					const items = selectableItems(mode, rows, chips);
					const result = handleSearchKey(event.key, navState.selectedIndex, items.length);
					if (result.preventDefault) event.preventDefault();
					if (result.selectedIndex !== navState.selectedIndex) {
						navState = {...navState, selectedIndex: result.selectedIndex};
						applySelection(items, navState.selectedIndex);
						items[navState.selectedIndex]?.scrollIntoView({block: 'nearest'});
					}
					if (!result.activate) return;
					const item = items[navState.selectedIndex];
					if (!item) return;
					if (mode === 'idle') {
						const query = item.dataset.csSearchSuggestion;
						if (query) setQuery(root, query);
						return;
					}
					resultLinkForRow(item)?.click();
				},
				true,
			);
		}
		siteSearch.querySelector('[data-open-modal]')?.addEventListener('click', () => {
			requestAnimationFrame(sync);
		});
		sync();
	}

	function init() {
		document.querySelectorAll('site-search').forEach((el) => {
			if (el instanceof HTMLElement) bindSiteSearch(el);
		});
	}

	init();
	document.addEventListener('astro:page-load', init);
</script>
