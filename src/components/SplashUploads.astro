---
/**
 * Homepage uploads beat — Callspec routes can take small files.
 */
import SplashIcon from './SplashIcon.astro';

const clientCode = `<span class="tok-kw">const</span> result = <span class="tok-kw">await</span> <span class="tok-fn">api</span>.<span class="tok-fn">upload</span>({
  file: input.files[0],
  caption: <span class="tok-str">'hi'</span>,
});`;
---

<section class="splash-sdk splash-uploads" aria-labelledby="splash-uploads-title">
	<div class="splash-sdk__inner">
		<header class="splash-sdk__intro">
			<h2 id="splash-uploads-title" class="splash-sdk__title">
				<span class="splash-h2-mark"><SplashIcon name="file" /></span>
				We do file uploads too
			</h2>
			<p class="splash-sdk__lede">
				Small files on the same RPC — avatars, CSVs, a PDF. file() on the input, a buffer in the
				handler. Not signed URLs, not a storage product.
			</p>
		</header>

		<figure class="splash-sdk__figure" aria-label="Upload client example">
			<pre class="splash-sdk__code" tabindex="0"><code set:html={clientCode} /></pre>
		</figure>
	</div>

	<p class="splash-sdk__footer">
		<a class="splash-sdk__link" href="/file-uploads/">File uploads</a>
	</p>
</section>
