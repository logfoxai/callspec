---
/**
 * Homepage scar: the OpenAPI/tooling pile vs one Callspec route.
 * Outcome only here — the `route()` code lives in How it works.
 */

const pile = [
	{name: 'openapi.yaml', note: 'hand-written or drifted'},
	{name: 'Orval / openapi-generator', note: 'SDK of uneven quality'},
	{name: 'swagger-ui', note: 'another package, another theme'},
	{name: 'error mapping', note: 'status codes → guesswork'},
	{name: 'custom MCP server', note: 'second API surface'},
	{name: 'auth wiring × N', note: 'docs, client, agents disagree'},
] as const;

const surfaces = ['Typed SDK', 'Docs UI', 'OpenAPI', 'MCP', 'Result errors'] as const;
---

<section class="splash-pile" aria-label="The pile versus one route">
	<p class="splash-pile__kicker">The problem</p>
	<div class="splash-pile__grid">
		<div class="splash-pile__pane splash-pile__pane--mess">
			<p class="splash-pile__label">The usual pile</p>
			<ul class="splash-pile__stack">
				{
					pile.map(({name, note}, i) => (
						<li class="splash-pile__chip" style={`--i: ${i}`}>
							<span class="splash-pile__chip-name">{name}</span>
							<span class="splash-pile__chip-note">{note}</span>
						</li>
					))
				}
			</ul>
			<p class="splash-pile__aside">
				Code-first OpenAPI helps a bit — you still stitch SDKs, docs, errors, and MCP yourself.
			</p>
		</div>

		<div class="splash-pile__pane splash-pile__pane--one">
			<p class="splash-pile__label">With Callspec</p>
			<p class="splash-pile__one-line">
				One TypeScript <code>route()</code>
			</p>
			<p class="splash-pile__arrow" aria-hidden="true">↓</p>
			<ul class="splash-pile__gets" aria-label="What you get">
				{surfaces.map((label) => <li>{label}</li>)}
			</ul>
			<p class="splash-pile__aside splash-pile__aside--one">
				Same auth. Same errors. Same methods for your app and for agents.
			</p>
		</div>
	</div>
</section>
