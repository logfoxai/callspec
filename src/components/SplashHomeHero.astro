---
/**
 * Marketing homepage hero — headline, pitch, lead, and pile graphic.
 */
import SplashHeroActions from './SplashHeroActions.astro';
import SplashPile from './SplashPile.astro';
import type {SplashHeroActionList} from '../splashHeroTypes';

const PAGE_TITLE_ID = '_top';

interface Props {
	title: string;
	headline: string;
	actions: SplashHeroActionList;
}

const {title, headline, actions = []} = Astro.props;

const homePitch = 'One TypeScript route → typed SDK, docs, OpenAPI, and MCP.';
---

<section class="splash-hero">
	<h1 id={PAGE_TITLE_ID} class="sr-only" data-page-title set:html={title} />
	{headline && <h2 class="splash-hero__headline">{headline}</h2>}
	<p class="splash-hero__pitch">{homePitch}</p>
	<SplashHeroActions actions={actions} />
	<div class="splash-hero__stage">
		<div class="splash-hero__lead">
			<p>
				Most teams maintain the same API in several places — OpenAPI, a hand-rolled client,
				docs, validators, MCP — and every change risks breaking more than one surface.
				That's brittle work that pulls you away from the product.
			</p>
			<p>
				Define each route once in TypeScript — inputs, outputs, and errors — then call{' '}
				<code>api.getProductById({'{…}'})</code> and get a <strong>Result</strong>: success
				or a typed error <code>code</code> you can switch on. Callspec ships the server, SDK,
				docs, OpenAPI, and MCP from that one contract — same methods and types everywhere,
				no drift.
			</p>
		</div>
		<div class="splash-hero__visual">
			<SplashPile />
		</div>
	</div>
</section>
