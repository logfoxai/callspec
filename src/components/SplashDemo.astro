---
/**
 * Homepage demo CTA — hosted Chirp explorer + local full stack.
 */
---

<section class="splash-demo">
	<div class="splash-demo__grid">
		<figure class="splash-demo__shot">
			<a href="/demo/" class="splash-demo__shot-link">
				<img
					src="/chirp-demo.png"
					alt="Chirp docs UI — routes sidebar, Connect MCP panel, Cursor MCP config"
					width="1600"
					height="1000"
					loading="lazy"
				/>
			</a>
		</figure>

		<div class="splash-demo__copy">
			<p class="splash-demo__kicker">Try it now</p>
			<h2 class="splash-demo__title">Open the Chirp API explorer</h2>
			<p class="splash-demo__lede">
				Browse a real Callspec surface — routes, schemas, and MCP connect configs for Cursor,
				Claude, and friends. No clone required.
			</p>
			<div class="splash-demo__actions">
				<a class="splash-demo__btn splash-demo__btn--primary" href="/demo/">
					Open Chirp explorer
					<span aria-hidden="true">→</span>
				</a>
			</div>
			<p class="splash-demo__hint">
				Want live try-it and MCP?
				<code>npm run serve:chirp-demo</code>
				<span class="splash-demo__token">Bearer token <code>demo</code></span>
			</p>
		</div>
	</div>
</section>
