---
/**
 * Homepage live-demo CTA — screenshot + copy.
 */
---

<section class="splash-demo">
	<div class="splash-demo__grid">
		<figure class="splash-demo__shot">
			<img
				src="/chirp-demo.png"
				alt="Chirp docs UI — routes sidebar, Connect MCP panel, Cursor MCP config"
				width="1600"
				height="1000"
				loading="lazy"
			/>
		</figure>

		<div class="splash-demo__copy">
			<p class="splash-demo__kicker">Live demo</p>
			<h2 class="splash-demo__title">Try the Chirp API explorer</h2>
			<p class="splash-demo__lede">
				Interactive docs UI, MCP connect flow, and a sample API — same Callspec explorer your APIs
				get.
			</p>
			<a class="splash-demo__cta" href="https://demo.callspec.dev/v1/docs">
				Open live demo
				<span aria-hidden="true">→</span>
			</a>
		</div>
	</div>
</section>
