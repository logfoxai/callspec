---
/**
 * Docs UI section — screenshot + CTAs into the explorer and local Chirp guide.
 */
import SplashHeroActions from './SplashHeroActions.astro';
import DemoScreenshot from './DemoScreenshot.astro';
import {withDemoLinkOpenAttrs} from './splashCtaIcons';

const demoShotAttrs = withDemoLinkOpenAttrs('/demo/');
---

<section class="splash-section splash-band splash-demo" aria-labelledby="splash-demo-title">
	<header class="splash-demo__intro">
		<h2 id="splash-demo-title" class="splash-demo__title">Built-in docs UI</h2>
		<p class="splash-demo__lede">
			Try-it panels, search, OpenAPI, and MCP connect — shipped with your API, no extra wiring.
			Whitelabel with your logo, accent, and nav links when you want; the defaults are simple and
			ready to go.
		</p>
		<SplashHeroActions
			actions={[
				{
					text: 'See the demo',
					link: '/demo/',
					variant: 'primary',
					icon: {type: 'icon', name: 'laptop'},
				},
				{
					text: 'Run it locally',
					link: '/try-the-demo-locally/',
					variant: 'secondary',
					icon: {type: 'icon', name: 'laptop'},
					attrs: {
						class: 'splash-demo__run-local',
						title: 'Start the live Chirp API — execute routes and connect MCP',
					},
				},
			]}
		/>
	</header>

	<DemoScreenshot
		link="/demo/"
		linkAttrs={demoShotAttrs}
		class="splash-demo__shot"
	/>
</section>
