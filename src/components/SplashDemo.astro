---
/**
 * Try path — hosted Chirp explorer (browse-only) + link to run it locally.
 */
import SplashHeroActions from './SplashHeroActions.astro';
import DemoScreenshot from './DemoScreenshot.astro';
import {withDemoLinkOpenAttrs} from './splashCtaIcons';

const demoShotAttrs = withDemoLinkOpenAttrs('/demo/');
---

<section class="splash-demo" aria-labelledby="splash-demo-title">
	<header class="splash-demo__intro">
		<h2 id="splash-demo-title" class="splash-demo__title">Try it</h2>
		<p class="splash-demo__lede">
			Chirp is Callspec's sample API. The hosted demo is browse-only — run it locally to execute
			routes and connect MCP.
		</p>
		<SplashHeroActions
			actions={[
				{text: 'See the demo', link: '/demo/', variant: 'primary'},
				{
					text: 'Run it locally',
					link: '/try-the-demo-locally/',
					variant: 'secondary',
					attrs: {
						title: 'Start the live Chirp API — execute routes and connect MCP',
					},
				},
			]}
		/>
	</header>

	<DemoScreenshot
		link="/demo/"
		linkAttrs={demoShotAttrs}
		class="splash-demo__shot"
	/>
</section>
