---
/**
 * Homepage demo CTA — screenshot + local Chirp run instructions.
 */
---

<section class="splash-demo">
	<div class="splash-demo__grid">
		<figure class="splash-demo__shot">
			<img
				src="/chirp-demo.png"
				alt="Chirp docs UI — routes sidebar, Connect MCP panel, Cursor MCP config"
				width="1600"
				height="1000"
				loading="lazy"
			/>
		</figure>

		<div class="splash-demo__copy">
			<p class="splash-demo__kicker">Try it locally</p>
			<h2 class="splash-demo__title">Run the Chirp API explorer</h2>
			<p class="splash-demo__lede">
				Clone the repo and start the sample API — interactive docs UI, MCP connect flow, and the
				same Callspec explorer your APIs get.
			</p>
			<div class="splash-demo__cmd" role="group" aria-label="Run the Chirp demo">
				<code>npm run build && npm run serve:chirp-demo</code>
			</div>
			<p class="splash-demo__hint">
				Then open <code>http://127.0.0.1:3456/v1/docs</code>
				<span class="splash-demo__token">Bearer token <code>demo</code></span>
			</p>
		</div>
	</div>
</section>
