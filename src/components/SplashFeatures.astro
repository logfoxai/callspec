---
/**
 * Homepage pillars — after How it works, the non-obvious wins.
 */

const icons = {
	test: `<svg viewBox="0 0 48 48" fill="none"><path d="M16 8h16v6.5c0 4.5-2.2 8.5-5.5 10.8L24 27l-2.5-1.7C18.2 23 16 19 16 14.5V8Z" stroke="currentColor" stroke-width="2.25" stroke-linejoin="round"/><path d="M18 8h12M20 36h8M24 27v9" stroke="currentColor" stroke-width="2.25" stroke-linecap="round"/><path d="M14 14h4M30 14h4" stroke="currentColor" stroke-width="2.25" stroke-linecap="round"/></svg>`,
	shield: `<svg viewBox="0 0 48 48" fill="none"><path d="M24 6L10 12v12c0 9.2 5.8 17.7 14 20.7 8.2-3 14-11.5 14-20.7V12L24 6Z" stroke="currentColor" stroke-width="2.25" stroke-linejoin="round"/><path d="M17.5 24.5 22 29l8.5-9.5" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
	mcp: `<svg viewBox="0 0 180 180" fill="none"><path d="M18 84.853 85.882 16.971c9.373-9.373 24.569-9.373 33.941 0s9.373 24.569 0 33.941L68.558 102.177" stroke="currentColor" stroke-width="12" stroke-linecap="round"/><path d="m69.265 101.47 50.558-50.558c9.373-9.373 24.569-9.373 33.942 0l.353.353c9.373 9.373 9.373 24.569 0 33.941L92.725 146.6c-3.124 3.124-3.124 8.189 0 11.313l12.606 12.607" stroke="currentColor" stroke-width="12" stroke-linecap="round"/><path d="m102.853 33.941-50.205 50.205c-9.372 9.372-9.372 24.568 0 33.941s24.569 9.372 33.941 0l50.205-50.205" stroke="currentColor" stroke-width="12" stroke-linecap="round"/></svg>`,
	sync: `<svg viewBox="0 0 48 48" fill="none"><path d="M34.5 18.5A11.5 11.5 0 0 0 16 14.2" stroke="currentColor" stroke-width="2.25" stroke-linecap="round"/><path d="M16 10v5.5h5.5" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"/><path d="M13.5 29.5A11.5 11.5 0 0 0 32 33.8" stroke="currentColor" stroke-width="2.25" stroke-linecap="round"/><path d="M32 38v-5.5h-5.5" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
} as const;

const features = [
	{
		tone: 'amber',
		title: 'Test the handler',
		copy: 'Call .handler(input, ctx) — no HTTP, no req/res mocks.',
		icon: 'test',
	},
	{
		tone: 'violet',
		title: 'Result-typed errors',
		copy: 'Exhaustive error codes from handler → SDK → MCP.',
		icon: 'shield',
	},
	{
		tone: 'cyan',
		title: 'MCP for free',
		copy: 'Same routes, auth, and errors as Cursor/Claude tools.',
		icon: 'mcp',
	},
	{
		tone: 'blue',
		title: 'No package dance',
		copy: 'Codegen the SDK — the frontend never imports your server.',
		icon: 'sync',
	},
] as const;
---

<section class="splash-features" aria-labelledby="splash-features-title">
	<h2 id="splash-features-title" class="splash-features__heading">Why it wins</h2>
	<ul class="splash-features__list">
		{
			features.map(({tone, title, copy, icon}) => (
				<li class="splash-features__item">
					<span class="splash-features__media">
						<span
							class="splash-features__icon"
							data-tone={tone}
							aria-hidden="true"
							set:html={icons[icon]}
						/>
					</span>
					<h3 class="splash-features__title">{title}</h3>
					<p class="splash-features__copy">{copy}</p>
				</li>
			))
		}
	</ul>
</section>
