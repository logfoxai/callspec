---
/**
 * Homepage highlight strip — product pillars + OSS trust card.
 * The FOSS card leads on wide layouts and is omitted at 2×2 / stacked breakpoints.
 */
import SplashIcon from './SplashIcon.astro';
import type {SplashIconName} from './SplashIcon.astro';

const features = [
	{
		tone: 'amber',
		title: 'Open source',
		copy: 'MIT licensed — free to use and\u00A0fork.',
		icon: 'unlock',
		wideOnly: true,
	},
	{
		tone: 'cyan',
		title: 'RPC routes',
		copy:
			'Methods like <code>getProductById</code> — not <code>GET /api/v2/product-catalog/items/{productId}/details</code>.',
		copyHtml: true,
		icon: 'rpc',
		wideOnly: false,
	},
	{
		tone: 'rose',
		title: 'Structured errors',
		copy: 'Errors as values with typed codes — no try/catch\u00A0needed.',
		icon: 'shield',
		wideOnly: false,
	},
	{
		tone: 'green',
		title: 'Test without HTTP',
		copy: 'Unit-test handler(input, ctx) — no server\u00A0setup.',
		icon: 'test',
		wideOnly: false,
	},
	{
		tone: 'mcp',
		title: 'MCP included',
		copy: 'Same routes become Cursor/Claude tools — no second\u00A0spec.',
		icon: 'mcp',
		wideOnly: false,
	},
] as const satisfies ReadonlyArray<{
	tone: string;
	title: string;
	copy: string;
	copyHtml?: boolean;
	icon: SplashIconName;
	wideOnly: boolean;
}>;
---

<section class="splash-features" aria-labelledby="splash-features-title">
	<h2 id="splash-features-title" class="splash-features__heading">Why Callspec</h2>
	<ul class="splash-features__list">
		{
			features.map(({tone, title, copy, copyHtml, icon, wideOnly}) => (
				<li class:list={['splash-features__item', wideOnly && 'splash-features__item--wide-only']}>
					<span class="splash-features__media">
						<span class="splash-features__icon" data-tone={tone} aria-hidden="true">
							<SplashIcon name={icon} />
						</span>
					</span>
					<h2 class="splash-features__title">{title}</h2>
					{
						copyHtml ? (
							<p class="splash-features__copy splash-features__copy--rpc" set:html={copy} />
						) : (
							<p class="splash-features__copy">{copy}</p>
						)
					}
				</li>
			))
		}
	</ul>
</section>
