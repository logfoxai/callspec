---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import SplashFlow from '../components/SplashFlow.astro';
import SplashFeatures from '../components/SplashFeatures.astro';
import SplashDemo from '../components/SplashDemo.astro';

const frontmatter = {
	title: 'Home',
	description:
		'Stop duct-taping your API stack. One TypeScript route → typed SDK, docs, OpenAPI, and MCP.',
	template: 'splash' as const,
	hero: {
		title: 'Callspec',
		tagline: 'Stop duct-taping your API stack.',
		actions: [
			{text: 'Get started', link: '/getting-started/'},
			{text: 'See the demo', link: '/demo/', variant: 'secondary' as const},
		],
	},
};
---

<StarlightPage frontmatter={frontmatter}>
	<div class="splash-page not-content">
		<SplashFlow />
		<SplashFeatures />
		<SplashDemo />
	</div>
</StarlightPage>
