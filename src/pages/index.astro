---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import '../components/splash.css';
import SplashHomeHero from '../components/SplashHomeHero.astro';
import SplashFlow from '../components/SplashFlow.astro';
import SplashDemo from '../components/SplashDemo.astro';
import SplashSdk from '../components/SplashSdk.astro';
import SplashAgents from '../components/SplashAgents.astro';
import SplashUploads from '../components/SplashUploads.astro';
import SplashAuth from '../components/SplashAuth.astro';
import SplashSupport from '../components/SplashSupport.astro';

const actions = [
	{
		text: 'Get started',
		link: '/getting-started/',
		icon: {type: 'icon', name: 'open-book'},
	},
	{
		text: 'See the demo',
		link: '/demo/',
		variant: 'secondary' as const,
		icon: {type: 'icon', name: 'laptop'},
	},
];
---

<StarlightPage
	frontmatter={{
		title: 'Callspec — typed SDK, docs, OpenAPI, and MCP from one route',
		description:
			'Spec-first TypeScript RPC. Define a route once and get a typed SDK, docs, OpenAPI, and MCP from the same contract.',
		template: 'splash',
		hero: {title: 'Callspec'},
		head: [{tag: 'title', content: 'Callspec — typed SDK, docs, OpenAPI, and MCP from one route'}],
	}}
>
	<div class="splash-page not-content">
		<SplashHomeHero
			title="Callspec"
			headline="Stop duct-taping your API stack."
			actions={actions}
		/>
		<SplashFlow />
		<SplashDemo />
		<SplashSdk />
		<SplashAgents />
		<SplashUploads />
		<SplashAuth />
		<SplashSupport />
	</div>
</StarlightPage>
