---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import '../components/splash.css';
import SplashHomeHero from '../components/SplashHomeHero.astro';
import SplashFlow from '../components/SplashFlow.astro';
import SplashDemo from '../components/SplashDemo.astro';
import SplashSdk from '../components/SplashSdk.astro';
import SplashAgents from '../components/SplashAgents.astro';

const actions = [
	{
		text: 'Get started',
		link: '/getting-started/',
		icon: {type: 'icon', name: 'open-book'},
	},
	{
		text: 'See the demo',
		link: '/demo/',
		variant: 'secondary' as const,
		icon: {type: 'icon', name: 'laptop'},
	},
];
---

<StarlightPage
	frontmatter={{
		title: 'Callspec',
		description:
			'Stop duct-taping your API stack. One TypeScript route → typed SDK, docs, OpenAPI, and MCP.',
		template: 'splash',
		hero: {title: 'Callspec'},
		head: [{tag: 'title', content: 'Callspec'}],
	}}
>
	<div class="splash-page not-content">
		<SplashHomeHero
			title="Callspec"
			headline="Stop duct-taping your API stack."
			actions={actions}
		/>
		<SplashFlow />
		<SplashDemo />
		<SplashSdk />
		<SplashAgents />
	</div>
</StarlightPage>
