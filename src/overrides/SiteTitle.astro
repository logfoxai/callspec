---
const {siteTitle, siteTitleHref} = Astro.locals.starlightRoute;

/** Hex outline only — the equals is punched via the mask below so it can animate. */
const hexPath =
	'M30.9 4.635A2.2 2.2 0 0 1 33.1 4.635L55.149 17.365A2.2 2.2 0 0 1 56.249 19.27V44.73A2.2 2.2 0 0 1 55.149 46.635L33.1 59.365A2.2 2.2 0 0 1 30.9 59.365L8.851 46.635A2.2 2.2 0 0 1 7.751 44.73V19.27A2.2 2.2 0 0 1 8.851 17.365Z';
---

<a href={siteTitleHref} class="site-title cs-lockup" translate="no">
	<svg
		class="cs-lockup__mark"
		viewBox="0 0 64 64"
		fill="none"
		xmlns="http://www.w3.org/2000/svg"
		aria-hidden="true"
	>
		<defs>
			<mask id="cs-eq-mask">
				<rect x="0" y="0" width="64" height="64" fill="white"></rect>
				<rect class="cs-eq cs-eq--top" x="19" y="24" width="26" height="6" rx="3" fill="black"
				></rect>
				<rect
					class="cs-eq cs-eq--bottom"
					x="19"
					y="34"
					width="26"
					height="6"
					rx="3"
					fill="black"></rect>
			</mask>
		</defs>
		<path class="cs-hex" d={hexPath} fill="currentColor" mask="url(#cs-eq-mask)"></path>
	</svg>
	<span class="cs-lockup__word" aria-hidden="true">callspec</span>
	<span class="sr-only">{siteTitle}</span>
</a>
