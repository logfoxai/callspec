---
/**
 * Splash and 404 bodies live in Astro (real LSP). Those MDX files are frontmatter only.
 */
import '@astrojs/starlight/style/markdown.css';
import SplashFlow from '../components/SplashFlow.astro';
import SplashFeatures from '../components/SplashFeatures.astro';
import SplashDemo from '../components/SplashDemo.astro';
import NotFoundPage from '../components/NotFoundPage.astro';

const {id} = Astro.locals.starlightRoute.entry;
---

<div class="sl-markdown-content">
	{
		id === 'index' ? (
			<div class="splash-page not-content">
				<SplashFlow />
				<SplashFeatures />
				<SplashDemo />
			</div>
		) : id === '404' ? (
			<NotFoundPage />
		) : (
			<slot />
		)
	}
</div>
