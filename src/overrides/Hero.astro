---
/**
 * Splash hero — brand, brutal promise, CTAs, and the pile as the first-viewport visual.
 */
import {LinkButton} from '@astrojs/starlight/components';
import SplashPile from '../components/SplashPile.astro';

const PAGE_TITLE_ID = '_top';
const {data} = Astro.locals.starlightRoute.entry;
const {title = data.title, tagline, actions = []} = data.hero || {};
const headline = tagline ? String(tagline).replace(/<[^>]*>/g, '') : '';

const lead =
	'YAML, Orval, swagger-ui, error maps, a bolted-on MCP server — five tools, three auth paths, constant drift. One TypeScript route replaces the pile.';
---

<section class="splash-hero">
	<p class="splash-hero__brand" aria-hidden="true">callspec</p>
	<h1 id={PAGE_TITLE_ID} class="sr-only" data-page-title set:html={title} />
	{
		headline && (
			<>
				<h2 class="splash-hero__headline">{headline}</h2>
				<p class="splash-hero__lead">{lead}</p>
			</>
		)
	}
	{
		actions.length > 0 && (
			<div class="splash-hero__actions">
				{actions.map(
					({attrs: {class: className, ...attrs} = {}, icon, link: href, text, variant}) => (
						<LinkButton
							{href}
							{variant}
							icon={icon?.name}
							iconPlacement={icon?.name === 'github' ? 'start' : 'end'}
							class:list={[
								className,
								icon?.name === 'right-arrow' && 'sl-link-button--forward',
								icon?.name === 'left-arrow' && 'sl-link-button--back',
							]}
							{...attrs}
						>
							{text}
							{icon?.html && <Fragment set:html={icon.html} />}
						</LinkButton>
					),
				)}
			</div>
		)
	}
	<div class="splash-hero__visual">
		<SplashPile />
	</div>
</section>

<script>
	/** Frost the splash nav after a short scroll (class toggled for CSS). */
	function syncSplashNav() {
		const onSplash = document.documentElement.matches(
			'[data-has-hero]:not([data-has-sidebar])',
		);
		document.documentElement.classList.toggle(
			'splash-nav-scrolled',
			onSplash && window.scrollY > 10,
		);
	}

	syncSplashNav();
	window.addEventListener('scroll', syncSplashNav, {passive: true});
	window.addEventListener('pageshow', syncSplashNav);
	document.addEventListener('astro:page-load', syncSplashNav);
</script>
