---
/**
 * Splash hero — visible brand title with CSS typewriter; guide pages use PageTitle.
 */
import {LinkButton} from '@astrojs/starlight/components';

const PAGE_TITLE_ID = '_top';
const {data} = Astro.locals.starlightRoute.entry;
const {title = data.title, tagline, actions = []} = data.hero || {};
const titlePlain = String(title).replace(/<[^>]*>/g, '');
const typeSteps = Math.max([...titlePlain].length, 1);
---

<section class="splash-hero">
	{/* Plain text — typewriter width/steps assume a single glyph run, not HTML. */}
	<h1
		id={PAGE_TITLE_ID}
		class="splash-hero__title"
		data-page-title
		style={`--type-steps: ${typeSteps}`}
	>
		{titlePlain}
	</h1>
	{tagline && <p class="splash-hero__tagline" set:html={tagline} />}
	{
		actions.length > 0 && (
			<div class="splash-hero__actions">
				{actions.map(
					({attrs: {class: className, ...attrs} = {}, icon, link: href, text, variant}) => (
						<LinkButton
							{href}
							{variant}
							icon={icon?.name}
							iconPlacement={icon?.name === 'github' ? 'start' : 'end'}
							class:list={[className]}
							{...attrs}
						>
							{text}
							{icon?.html && <Fragment set:html={icon.html} />}
						</LinkButton>
					),
				)}
			</div>
		)
	}
</section>

<script>
	/** Frost the splash nav after a short scroll (class toggled for CSS). */
	function syncSplashNav() {
		const onSplash = document.documentElement.matches(
			'[data-has-hero]:not([data-has-sidebar])',
		);
		document.documentElement.classList.toggle(
			'splash-nav-scrolled',
			onSplash && window.scrollY > 10,
		);
	}

	syncSplashNav();
	window.addEventListener('scroll', syncSplashNav, {passive: true});
	window.addEventListener('pageshow', syncSplashNav);
	document.addEventListener('astro:page-load', syncSplashNav);
</script>
