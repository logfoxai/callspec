---
/**
 * Site-style sun/moon slider — keeps Starlight theme storage + ThemeProvider in sync.
 */
import Slider from '../components/Slider.astro';

const themeSliderSunPath =
	'M5 12a1 1 0 0 0-1-1H3a1 1 0 0 0 0 2h1a1 1 0 0 0 1-1Zm.64 5-.71.71a1 1 0 0 0 0 1.41 1 1 0 0 0 1.41 0l.71-.71A1 1 0 0 0 5.64 17ZM12 5a1 1 0 0 0 1-1V3a1 1 0 0 0-2 0v1a1 1 0 0 0 1 1Zm5.66 2.34a1 1 0 0 0 .7-.29l.71-.71a1 1 0 1 0-1.41-1.41l-.66.71a1 1 0 0 0 0 1.41 1 1 0 0 0 .66.29Zm-12-.29a1 1 0 0 0 1.41 0 1 1 0 0 0 0-1.41l-.71-.71a1.004 1.004 0 1 0-1.43 1.41l.73.71ZM21 11h-1a1 1 0 0 0 0 2h1a1 1 0 0 0 0-2Zm-2.64 6A1 1 0 0 0 17 18.36l.71.71a1 1 0 0 0 1.41 0 1 1 0 0 0 0-1.41l-.76-.66ZM12 6.5a5.5 5.5 0 1 0 5.5 5.5A5.51 5.51 0 0 0 12 6.5Zm0 9a3.5 3.5 0 1 1 0-7 3.5 3.5 0 0 1 0 7Zm0 3.5a1 1 0 0 0-1 1v1a1 1 0 0 0 2 0v-1a1 1 0 0 0-1-1Z';
const themeSliderMoonPath =
	'M21.64 13a1 1 0 0 0-1.05-.14 8.049 8.049 0 0 1-3.37.73 8.15 8.15 0 0 1-8.14-8.1 8.59 8.59 0 0 1 .25-2A1 1 0 0 0 8 2.36a10.14 10.14 0 1 0 14 11.69 1 1 0 0 0-.36-1.05Zm-9.5 6.69A8.14 8.14 0 0 1 7.08 5.22v.27a10.15 10.15 0 0 0 10.14 10.14 9.784 9.784 0 0 0 2.1-.22 8.11 8.11 0 0 1-7.18 4.32v-.04Z';
---

<starlight-theme-select>
	<Slider
		class="theme-slider--icon"
		aria-label={Astro.locals.t('themeSelect.accessibleLabel')}
		aria-pressed="false"
		title="Theme: Light — click to toggle"
	>
		<svg slot="start" viewBox="0 0 24 24" aria-hidden="true">
			<path d={themeSliderSunPath} fill="currentColor" />
		</svg>
		<svg slot="end" viewBox="0 0 24 24" aria-hidden="true">
			<path d={themeSliderMoonPath} fill="currentColor" />
		</svg>
	</Slider>
</starlight-theme-select>

<script is:inline>
	StarlightThemeProvider.updatePickers();
</script>

<script>
	type Theme = 'auto' | 'dark' | 'light';
	type Resolved = 'dark' | 'light';

	const storageKey = 'starlight-theme';

	const parseTheme = (theme: unknown): Theme =>
		theme === 'auto' || theme === 'dark' || theme === 'light' ? theme : 'auto';

	const getPreferredColorScheme = (): Resolved =>
		matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';

	const loadTheme = (): Theme => {
		if (typeof localStorage === 'undefined') return 'auto';
		const raw = localStorage.getItem(storageKey);
		if (raw === null || raw === '') return 'auto';
		return parseTheme(raw);
	};

	function storeTheme(theme: Theme): void {
		if (typeof localStorage === 'undefined') return;
		localStorage.setItem(storageKey, theme === 'light' || theme === 'dark' ? theme : '');
	}

	function resolveTheme(theme: Theme): Resolved {
		return theme === 'auto' ? getPreferredColorScheme() : theme;
	}

	function syncSliderButton(button: HTMLButtonElement, theme: Theme, resolved: Resolved): void {
		const dark = resolved === 'dark';
		button.classList.toggle('is-end', dark);
		button.dataset.themeValue = theme;
		button.setAttribute('aria-pressed', dark ? 'true' : 'false');
		const label =
			theme === 'auto' ? `System (${resolved})` : resolved === 'dark' ? 'Dark' : 'Light';
		button.title = `Theme: ${label} — click to toggle`;
	}

	function syncAllSliders(theme: Theme, resolved: Resolved): void {
		document.querySelectorAll('starlight-theme-select .theme-slider').forEach((el) => {
			if (el instanceof HTMLButtonElement) syncSliderButton(el, theme, resolved);
		});
	}

	function onThemeChange(theme: Theme): void {
		const resolved = resolveTheme(theme);
		const commit = () => {
			StarlightThemeProvider.updatePickers(theme);
			document.documentElement.dataset.theme = resolved;
			storeTheme(theme);
			syncAllSliders(theme, resolved);
		};
		if (
			typeof document.startViewTransition === 'function' &&
			!matchMedia('(prefers-reduced-motion: reduce)').matches
		) {
			document.startViewTransition(commit);
			return;
		}
		commit();
	}

	matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => {
		if (loadTheme() === 'auto') onThemeChange('auto');
	});

	class StarlightThemeSelect extends HTMLElement {
		constructor() {
			super();
			const button = this.querySelector('.theme-slider');
			if (!(button instanceof HTMLButtonElement)) return;

			const theme = loadTheme();
			const resolved = resolveTheme(theme);
			syncSliderButton(button, theme, resolved);

			button.addEventListener('click', () => {
				const currentResolved = resolveTheme(loadTheme());
				onThemeChange(currentResolved === 'dark' ? 'light' : 'dark');
			});
		}
	}

	customElements.define('starlight-theme-select', StarlightThemeSelect);
</script>
