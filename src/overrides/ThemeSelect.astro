---
/**
 * Click-to-toggle theme switch — sun/moon inside the track.
 * Default preference is system; UI is light ↔ dark only (no middle).
 */
import {Icon} from '@astrojs/starlight/components';
---

<starlight-theme-select>
	<button
		type="button"
		class="theme-slider"
		data-theme-value="auto"
		data-resolved="dark"
		aria-label={Astro.locals.t('themeSelect.accessibleLabel')}
		aria-pressed="false"
		title="Theme: System"
	>
		<span class="theme-slider__shell">
			<span class="theme-slider__icon theme-slider__icon--sun" aria-hidden="true">
				<Icon name="sun" />
			</span>
			<span class="theme-slider__icon theme-slider__icon--moon" aria-hidden="true">
				<Icon name="moon" />
			</span>
			<span class="theme-slider__thumb" aria-hidden="true"></span>
		</span>
	</button>
</starlight-theme-select>

<script is:inline>
	StarlightThemeProvider.updatePickers();
</script>

<script>
	type Theme = 'auto' | 'dark' | 'light';
	type Resolved = 'dark' | 'light';

	const storageKey = 'starlight-theme';

	const parseTheme = (theme: unknown): Theme =>
		theme === 'auto' || theme === 'dark' || theme === 'light' ? theme : 'auto';

	const getPreferredColorScheme = (): Resolved =>
		matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';

	const loadTheme = (): Theme => {
		if (typeof localStorage === 'undefined') return 'auto';
		const raw = localStorage.getItem(storageKey);
		// Starlight stores auto as empty string; unset → system
		if (raw === null || raw === '') return 'auto';
		return parseTheme(raw);
	};

	function storeTheme(theme: Theme): void {
		if (typeof localStorage === 'undefined') return;
		localStorage.setItem(storageKey, theme === 'light' || theme === 'dark' ? theme : '');
	}

	function resolveTheme(theme: Theme): Resolved {
		return theme === 'auto' ? getPreferredColorScheme() : theme;
	}

	function onThemeChange(theme: Theme): void {
		const resolved = resolveTheme(theme);
		StarlightThemeProvider.updatePickers(theme);
		document.documentElement.dataset.theme = resolved;
		storeTheme(theme);

		const button = document.querySelector('starlight-theme-select .theme-slider');
		if (!(button instanceof HTMLButtonElement)) return;

		button.dataset.themeValue = theme;
		button.dataset.resolved = resolved;
		button.setAttribute('aria-pressed', resolved === 'dark' ? 'true' : 'false');
		const label =
			theme === 'auto' ? `System (${resolved})` : resolved === 'dark' ? 'Dark' : 'Light';
		button.title = `Theme: ${label} — click to toggle`;
	}

	matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => {
		if (loadTheme() === 'auto') onThemeChange('auto');
	});

	class StarlightThemeSelect extends HTMLElement {
		constructor() {
			super();
			const button = this.querySelector('.theme-slider');
			if (!(button instanceof HTMLButtonElement)) return;

			onThemeChange(loadTheme());

			button.addEventListener('click', () => {
				const resolved = resolveTheme(loadTheme());
				onThemeChange(resolved === 'dark' ? 'light' : 'dark');
			});
		}
	}

	customElements.define('starlight-theme-select', StarlightThemeSelect);
</script>

<style>
	.theme-slider {
		--ts-track: var(--sl-color-gray-5);
		--ts-thumb: var(--sl-color-white);
		--ts-ink: var(--sl-color-gray-2);
		--ts-ink-on-thumb: #12141a;
		display: grid;
		place-items: center;
		width: auto;
		height: 2.5rem;
		margin: 0;
		padding-inline: 0.15rem;
		border: 0;
		background: transparent;
		cursor: pointer;
		color: inherit;
	}

	.theme-slider__shell {
		position: relative;
		width: 3.15rem;
		height: 1.55rem;
		border-radius: 999px;
		background: var(--ts-track);
		box-shadow: inset 0 0 0 1px var(--sl-color-hairline);
		transition: background-color 0.15s ease, box-shadow 0.15s ease;
	}

	.theme-slider:hover .theme-slider__shell {
		box-shadow: inset 0 0 0 1px var(--sl-color-gray-2);
	}

	.theme-slider:focus-visible {
		outline: none;
	}

	.theme-slider:focus-visible .theme-slider__shell {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 2px;
	}

	.theme-slider__icon {
		position: absolute;
		top: 50%;
		z-index: 1;
		display: grid;
		place-items: center;
		width: 1.15rem;
		height: 1.15rem;
		transform: translateY(-50%);
		color: var(--ts-ink);
		opacity: 0.65;
		pointer-events: none;
		transition: opacity 0.15s ease, color 0.15s ease;
	}

	.theme-slider__icon--sun {
		left: 0.2rem;
	}

	.theme-slider__icon--moon {
		right: 0.2rem;
	}

	.theme-slider__icon :global(svg) {
		width: 0.85rem;
		height: 0.85rem;
	}

	.theme-slider[data-resolved='light'] .theme-slider__icon--sun,
	.theme-slider[data-resolved='dark'] .theme-slider__icon--moon {
		z-index: 3;
		color: var(--ts-ink-on-thumb);
		opacity: 1;
	}

	.theme-slider__thumb {
		position: absolute;
		top: 50%;
		left: 0.16rem;
		z-index: 2;
		width: 1.22rem;
		height: 1.22rem;
		border-radius: 50%;
		background: var(--ts-thumb);
		box-shadow:
			0 1px 2px rgb(0 0 0 / 22%),
			0 0 0 1px color-mix(in srgb, var(--sl-color-gray-2) 22%, transparent);
		transform: translate(0, -50%);
		transition: transform 0.18s ease;
		pointer-events: none;
	}

	.theme-slider[data-resolved='dark'] .theme-slider__thumb {
		transform: translate(1.6rem, -50%);
	}

	@media (prefers-reduced-motion: reduce) {
		.theme-slider__thumb,
		.theme-slider__icon,
		.theme-slider__shell {
			transition: none;
		}
	}
</style>
