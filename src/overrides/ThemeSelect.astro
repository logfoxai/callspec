---
/**
 * Light/dark theme switch — clearer than cycling through Auto with a laptop icon.
 */
---

<starlight-theme-select>
	<label class="theme-switch">
		<span class="sr-only">Dark mode</span>
		<input
			type="checkbox"
			class="theme-switch__input"
			role="switch"
			aria-checked="false"
			aria-label="Toggle dark mode"
		/>
		<span class="theme-switch__track" aria-hidden="true">
			<span class="theme-switch__thumb"></span>
		</span>
	</label>
</starlight-theme-select>

<script is:inline>
	StarlightThemeProvider.updatePickers();
</script>

<script>
	type Theme = 'dark' | 'light';

	const storageKey = 'starlight-theme';

	const parseTheme = (theme: unknown): Theme | null =>
		theme === 'dark' || theme === 'light' ? theme : null;

	const getPreferredColorScheme = (): Theme =>
		matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';

	const loadTheme = (): Theme => {
		const stored = parseTheme(
			typeof localStorage !== 'undefined' && localStorage.getItem(storageKey),
		);
		return stored ?? getPreferredColorScheme();
	};

	function storeTheme(theme: Theme): void {
		if (typeof localStorage !== 'undefined') {
			localStorage.setItem(storageKey, theme);
		}
	}

	function onThemeChange(theme: Theme): void {
		StarlightThemeProvider.updatePickers(theme);
		document.documentElement.dataset.theme = theme;
		storeTheme(theme);
		const input = document.querySelector('starlight-theme-select .theme-switch__input');
		if (input instanceof HTMLInputElement) {
			const dark = theme === 'dark';
			input.checked = dark;
			input.setAttribute('aria-checked', dark ? 'true' : 'false');
			input.title = dark ? 'Dark mode on — click for light' : 'Light mode on — click for dark';
		}
	}

	class StarlightThemeSelect extends HTMLElement {
		constructor() {
			super();
			const input = this.querySelector('.theme-switch__input');
			if (!(input instanceof HTMLInputElement)) return;
			onThemeChange(loadTheme());
			input.addEventListener('change', () => {
				onThemeChange(input.checked ? 'dark' : 'light');
			});
		}
	}

	customElements.define('starlight-theme-select', StarlightThemeSelect);
</script>

<style>
	.theme-switch {
		display: grid;
		place-items: center;
		width: 2.75rem;
		height: 2.5rem;
		margin: 0;
		cursor: pointer;
	}

	.theme-switch__input {
		position: absolute;
		opacity: 0;
		width: 1px;
		height: 1px;
		margin: 0;
		pointer-events: none;
	}

	.theme-switch__track {
		display: block;
		position: relative;
		width: 2.4rem;
		height: 1.3rem;
		border-radius: 999px;
		background: var(--sl-color-gray-5);
		border: 1px solid var(--sl-color-hairline);
		transition: background-color 0.15s ease, border-color 0.15s ease;
	}

	.theme-switch__thumb {
		position: absolute;
		top: 50%;
		left: 0.15rem;
		width: 0.95rem;
		height: 0.95rem;
		border-radius: 50%;
		background: var(--sl-color-white);
		transform: translateY(-50%);
		transition: transform 0.15s ease;
		box-shadow: 0 1px 2px rgb(0 0 0 / 25%);
	}

	.theme-switch__input:checked + .theme-switch__track {
		background: color-mix(in srgb, var(--sl-color-accent) 55%, var(--sl-color-gray-5));
		border-color: color-mix(in srgb, var(--sl-color-accent) 40%, var(--sl-color-hairline));
	}

	.theme-switch__input:checked + .theme-switch__track .theme-switch__thumb {
		transform: translate(1rem, -50%);
	}

	.theme-switch__input:focus-visible + .theme-switch__track {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 2px;
	}

	.theme-switch:hover .theme-switch__track {
		border-color: var(--sl-color-gray-2);
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}
</style>
